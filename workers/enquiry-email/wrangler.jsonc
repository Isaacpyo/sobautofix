{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sobautofix-enquiry-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },
  "addresses": ["enquiry@reply.sobautofix.com"],
  "vars": {
    "SOB_AUTOFIX_INBOUND_ENDPOINT": "https://sobautofix.com/api/webhooks/cloudflare-email"
  }
}
